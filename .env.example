# ===== LLM 配置 =====
# 兼容 OpenAI 协议的模型服务（OpenAI / DeepSeek / Qwen / Moonshot 等）
LLM_API_KEY=sk-xxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=30

# ===== LangSmith 可观测性 =====
LANGSMITH_API_KEY=lsv2_pt_xxxxx
LANGSMITH_PROJECT=exercise-agent-dev
LANGCHAIN_TRACING_V2=true

# ===== 智能体服务 =====
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8000
LOG_LEVEL=INFO

# ===== 数据存储（阶段1骨架可留空，使用内存/checkpoint sqlite）=====
# PostgreSQL（用户画像、运动历史、LangGraph checkpointer 落盘）
POSTGRES_URL=
# Redis（Session Memory / 短期对话）
REDIS_URL=
# 向量库（运动医学知识库 / 动作库）
VECTOR_DB_URL=

# ===== 外部业务接口（阶段2接入，骨架阶段留空走 Mock）=====
HEALTH_DATA_API_BASE=
WEATHER_API_BASE=
WEATHER_API_KEY=
